<UserControl
 x:Class="WechatMemory.NativeApp.MessageCardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:viewmodels="using:WechatMemory.NativeApp.ViewModels">
 <StackPanel Spacing="6" Visibility="{x:Bind Vm.HasCard, Mode=OneWay}" HorizontalAlignment="Stretch">
  <TextBlock Text="{x:Bind Vm.ReplyRelationLabel, Mode=OneWay}" Visibility="{x:Bind Vm.HasReplyRelation, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
  <Expander Header="{x:Bind Vm.QuoteHeader, Mode=OneWay}" Visibility="{x:Bind Vm.HasQuote, Mode=OneWay}" IsExpanded="{x:Bind Vm.IsQuoteExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="QuoteSummaryExpander">
   <TextBlock Text="{x:Bind Vm.QuoteSummary, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12"/>
  </Expander>
  <Expander Header="{x:Bind Vm.ForwardHeader, Mode=OneWay}" Visibility="{x:Bind Vm.HasForwardItems, Mode=OneWay}" IsExpanded="{x:Bind Vm.IsForwardExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="ForwardItemsExpander">
   <!-- No nested ScrollViewer or navigation buttons: the surrounding message list
        retains keyboard/scroll ownership. Rows exist only while expanded. -->
   <ItemsControl ItemsSource="{x:Bind Vm.ForwardItems, Mode=OneWay}" HorizontalContentAlignment="Stretch">
    <ItemsControl.ItemTemplate><DataTemplate x:DataType="viewmodels:ForwardItemPresentation">
     <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,6">
      <StackPanel Spacing="3">
       <TextBlock Text="{x:Bind Label}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
       <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12"/>
      </StackPanel>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </Expander>
  <!-- Coverage/truncation stays visible even when either card is collapsed. -->
  <TextBlock Text="{x:Bind Vm.Notice, Mode=OneWay}" Visibility="{x:Bind Vm.HasNotice, Mode=OneWay}" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
 </StackPanel>
</UserControl>
