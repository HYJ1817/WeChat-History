<Window x:Class="WechatMemory.NativeApp.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:WechatMemory.NativeApp"
 xmlns:models="using:WechatMemory.NativeApp.Models">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" SizeChanged="Root_SizeChanged" Loaded="Root_Loaded" Padding="16,0,16,12" RowSpacing="12">
  <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <!-- Custom title bar: keeps the caption buttons, hides the system app icon/title. -->
  <Grid x:Name="TitleBarDragRegion" Margin="-16,0,-16,0" Background="Transparent"/>

  <!-- Header -->
  <Grid Grid.Row="1" ColumnSpacing="16" Margin="0,14,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" Spacing="12">
    <Border Width="40" Height="40" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
     <FontIcon Glyph="&#xE8BD;" FontSize="20" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
    </Border>
    <StackPanel Spacing="2" VerticalAlignment="Center">
     <TextBlock Text="微信记忆" FontSize="24" FontWeight="SemiBold"/>
     <TextBlock Text="{x:Bind Vm.SourceLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
    <TextBlock Text="{x:Bind Vm.ConnectionLabel, Mode=OneWay}" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
    <Button Content="重新检测" Command="{x:Bind Vm.ReconnectCommand}" AutomationProperties.AutomationId="ReconnectButton"/>
   </StackPanel>
  </Grid>

  <!-- Workspace -->
  <Grid x:Name="Workspace" Grid.Row="2" ColumnSpacing="14" RowSpacing="12">
   <Grid.ColumnDefinitions>
    <ColumnDefinition x:Name="ConversationColumn" Width="252"/>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition x:Name="ExportColumn" Width="324"/>
   </Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="ExportRow" Height="0"/></Grid.RowDefinitions>

   <!-- Source and conversations -->
   <Border Grid.RowSpan="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
    <Grid RowSpacing="10">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
     </Grid.RowDefinitions>
     <TextBlock Text="数据源" FontWeight="SemiBold"/>
     <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
      <FontIcon Glyph="&#xE8BD;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
      <TextBlock Text="{x:Bind Vm.SourceModeLabel, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </StackPanel>
     <Grid Grid.Row="2" ColumnSpacing="6" Visibility="{x:Bind Vm.IsWechatMode, Mode=OneWay}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ComboBox ItemsSource="{x:Bind Vm.Accounts}" SelectedItem="{x:Bind Vm.SelectedAccount, Mode=TwoWay}" DisplayMemberPath="Label" Header="微信账户" HorizontalAlignment="Stretch" IsEnabled="{x:Bind Vm.CanConnect, Mode=OneWay}" AutomationProperties.AutomationId="AccountCombo"/>
      <Button Grid.Column="1" Content="刷新" Command="{x:Bind Vm.RefreshAccountsCommand}" VerticalAlignment="Bottom" AutomationProperties.AutomationId="RefreshAccountsButton"/>
     </Grid>
     <TextBlock Grid.Row="3" Text="{x:Bind Vm.AccountHint, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <StackPanel Grid.Row="4" Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="6">
       <Button Content="连接微信" Click="ConnectWechat_Click" IsEnabled="{x:Bind Vm.CanConnectWechat, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" Visibility="{x:Bind Vm.IsWechatMode, Mode=OneWay}" AutomationProperties.AutomationId="ConnectWechatButton"/>
       <Button Content="断开" Command="{x:Bind Vm.DisconnectCommand}" Visibility="{x:Bind Vm.IsWechatMode, Mode=OneWay}"/>
      </StackPanel>
      <Button Content="导入离线 JSON…" Click="ImportJson_Click" IsEnabled="{x:Bind Vm.CanImportJson, Mode=OneWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ImportJsonButton"/>
     </StackPanel>
     <Grid Grid.Row="5" ColumnSpacing="6">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox Text="{x:Bind Vm.ConversationQuery, Mode=TwoWay}" PlaceholderText="按会话名称筛选" IsEnabled="{x:Bind Vm.CanSelectConversation, Mode=OneWay}" AutomationProperties.AutomationId="ConversationSearch"/>
      <Button Grid.Column="1" Content="筛选" Command="{x:Bind Vm.SearchConversationsCommand}" AutomationProperties.AutomationId="SearchConversationsButton"/>
     </Grid>
     <TextBlock Grid.Row="6" Text="会话" FontWeight="SemiBold" Margin="0,4,0,0"/>
     <ListView Grid.Row="7" x:Name="ConversationList" AutomationProperties.AutomationId="ConversationList" ItemsSource="{x:Bind Vm.Conversations}" SelectedItem="{x:Bind Vm.SelectedConversation, Mode=TwoWay}" IsEnabled="{x:Bind Vm.CanSelectConversation, Mode=OneWay}" SelectionMode="Single" HorizontalContentAlignment="Stretch">
      <ListView.ItemTemplate><DataTemplate x:DataType="models:Conversation">
       <StackPanel Spacing="3" Padding="2,8">
        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{x:Bind CountLabel}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11"/>
       </StackPanel>
      </DataTemplate></ListView.ItemTemplate>
     </ListView>
    </Grid>
   </Border>

   <!-- Messages -->
   <Grid Grid.Column="1" RowSpacing="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="10">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="{x:Bind Vm.SelectedTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="SelectedTitle"/>
     <Border Grid.Column="1" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center" Visibility="{x:Bind Vm.ShowConversationMessages, Mode=OneWay}">
      <TextBlock Text="{x:Bind Vm.SelectedConversation.CountLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     </Border>
    </Grid>
    <StackPanel Grid.Row="1" Spacing="6">
     <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="{x:Bind Vm.BrowseModeLabel, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <Button Content="当前会话" Command="{x:Bind Vm.SwitchToConversationCommand}" IsEnabled="{x:Bind Vm.CanSwitchToConversation, Mode=OneWay}"/>
      <Button Content="全局搜索" Command="{x:Bind Vm.SwitchToGlobalSearchCommand}" IsEnabled="{x:Bind Vm.CanSwitchToGlobalSearch, Mode=OneWay}"/>
     </StackPanel>
     <TextBlock Text="当前工作进程或数据源不支持全局搜索。" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="{x:Bind Vm.IsGlobalSearchUnavailable, Mode=OneWay}"/>
     <StackPanel Spacing="6" Visibility="{x:Bind Vm.ShowConversationMessages, Mode=OneWay}">
      <StackPanel Orientation="Horizontal" Spacing="6">
       <CalendarDatePicker x:Name="StartPicker" AutomationProperties.AutomationId="StartDate" Header="开始日期" PlaceholderText="不限" Date="{x:Bind Vm.StartDate, Mode=TwoWay}" IsEnabled="{x:Bind Vm.CanWork, Mode=OneWay}" Width="148"/>
       <CalendarDatePicker x:Name="EndPicker" AutomationProperties.AutomationId="EndDate" Header="结束日期（包含）" PlaceholderText="不限" Date="{x:Bind Vm.EndDate, Mode=TwoWay}" IsEnabled="{x:Bind Vm.CanWork, Mode=OneWay}" Width="148"/>
       <Button Content="应用筛选" Command="{x:Bind Vm.ApplyFiltersCommand}" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="ApplyFilterButton"/>
       <Button Content="清除条件" Command="{x:Bind Vm.ClearFiltersCommand}" VerticalAlignment="Bottom" AutomationProperties.AutomationId="ClearFilterButton"/>
      </StackPanel>
      <Grid ColumnSpacing="6">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBox x:Name="MessageSearchBox" Text="{x:Bind Vm.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="搜索消息内容或发送者" IsEnabled="{x:Bind Vm.CanWork, Mode=OneWay}" KeyDown="MessageSearchBox_KeyDown" TextCompositionStarted="SearchBox_CompositionStarted" TextCompositionEnded="SearchBox_CompositionEnded" LostFocus="SearchBox_LostFocus" AutomationProperties.AutomationId="MessageSearch"/>
       <Button Grid.Column="1" Content="搜索" Command="{x:Bind Vm.ApplyFiltersCommand}" IsEnabled="{x:Bind Vm.CanApplyFilters, Mode=OneWay}" AutomationProperties.AutomationId="SearchMessagesButton"/>
      </Grid>
      <TextBlock Text="{x:Bind Vm.RangeLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="RangeLabel"/>
      <TextBlock Text="{x:Bind Vm.MessagePagingStatus, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="MessagePagingStatus"/>
     </StackPanel>
     <StackPanel Spacing="6" Visibility="{x:Bind Vm.ShowGlobalSearchResults, Mode=OneWay}">
      <StackPanel Orientation="Horizontal" Spacing="6">
       <CalendarDatePicker AutomationProperties.AutomationId="GlobalStartDate" Header="开始日期" PlaceholderText="不限" Date="{x:Bind Vm.GlobalStartDate, Mode=TwoWay}" IsEnabled="{x:Bind Vm.CanEditGlobalFilters, Mode=OneWay}" Width="138"/>
       <CalendarDatePicker AutomationProperties.AutomationId="GlobalEndDate" Header="结束日期（包含）" PlaceholderText="不限" Date="{x:Bind Vm.GlobalEndDate, Mode=TwoWay}" IsEnabled="{x:Bind Vm.CanEditGlobalFilters, Mode=OneWay}" Width="138"/>
       <ComboBox Header="顺序" SelectedValuePath="Tag" SelectedValue="{x:Bind Vm.GlobalSearchOrder, Mode=TwoWay}" IsEnabled="{x:Bind Vm.CanEditGlobalFilters, Mode=OneWay}" Width="108">
        <ComboBoxItem Content="最新" Tag="desc"/>
        <ComboBoxItem Content="最早" Tag="asc"/>
       </ComboBox>
       <Button Content="搜索" Command="{x:Bind Vm.ApplyFiltersCommand}" IsEnabled="{x:Bind Vm.CanApplyFilters, Mode=OneWay}" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="GlobalSearchButton"/>
       <Button Content="清除" Command="{x:Bind Vm.ClearFiltersCommand}" IsEnabled="{x:Bind Vm.CanClearFilters, Mode=OneWay}" VerticalAlignment="Bottom" AutomationProperties.AutomationId="ClearGlobalSearchButton"/>
      </StackPanel>
      <Grid ColumnSpacing="6">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBox x:Name="GlobalSearchBox" Text="{x:Bind Vm.GlobalSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="搜索所有会话的发送者、正文、类型或已有转写" IsEnabled="{x:Bind Vm.CanEditGlobalFilters, Mode=OneWay}" KeyDown="MessageSearchBox_KeyDown" TextCompositionStarted="SearchBox_CompositionStarted" TextCompositionEnded="SearchBox_CompositionEnded" LostFocus="SearchBox_LostFocus" AutomationProperties.AutomationId="GlobalMessageSearch"/>
       <Button Grid.Column="1" Content="执行" Command="{x:Bind Vm.ApplyFiltersCommand}" IsEnabled="{x:Bind Vm.CanApplyFilters, Mode=OneWay}"/>
      </Grid>
      <TextBlock Text="{x:Bind Vm.GlobalSearchSummary, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
      <TextBlock Text="{x:Bind Vm.GlobalAppliedFiltersLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{x:Bind Vm.GlobalSearchStatus, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
      <TextBlock Text="{x:Bind Vm.GlobalCoverageNotice, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
     </StackPanel>
     <StackPanel Spacing="6" Visibility="{x:Bind Vm.ShowMessageContext, Mode=OneWay}">
      <StackPanel Orientation="Horizontal" Spacing="6">
       <Button Content="返回全局搜索结果" Click="ReturnToSearch_Click" IsEnabled="{x:Bind Vm.CanReturnToSearch, Mode=OneWay}" AutomationProperties.AutomationId="ReturnToGlobalSearch"/>
       <Button Content="在此会话中浏览" Command="{x:Bind Vm.BrowseContextConversationCommand}" IsEnabled="{x:Bind Vm.CanBrowseContextConversation, Mode=OneWay}" AutomationProperties.AutomationId="BrowseContextConversation"/>
       <TextBlock Text="{x:Bind Vm.ContextSummary, Mode=OneWay}" VerticalAlignment="Center" FontSize="11"/>
      </StackPanel>
      <TextBlock Text="{x:Bind Vm.ContextCoverageNotice, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
     </StackPanel>
    </StackPanel>
    <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
     <Grid>
      <ListView x:Name="MessageList" AutomationProperties.AutomationId="MessageList" ItemsSource="{x:Bind Vm.Messages}" SelectionMode="None" HorizontalContentAlignment="Stretch" Visibility="{x:Bind Vm.ShowConversationMessages, Mode=OneWay}">
       <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel/></ItemsPanelTemplate></ListView.ItemsPanel>
       <ListView.ItemTemplate><DataTemplate x:DataType="models:ChatMessage">
        <Grid Padding="14,10" RowSpacing="5">
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{x:Bind Sender}" FontWeight="SemiBold"/>
          <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="6,0" VerticalAlignment="Center">
           <TextBlock Text="{x:Bind KindLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </Border>
          <TextBlock Text="{x:Bind TimeLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
          <TextBlock Text="{x:Bind FocusLabel}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
         </StackPanel>
         <TextBlock Grid.Row="1" Text="{x:Bind Content}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
         <TextBlock Grid.Row="2" Text="{x:Bind Transcript}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind HasTranscript}"/>
         <Button Grid.Row="3" Content="{x:Bind AttachmentLabel}" Click="OpenAttachment_Click" HorizontalAlignment="Left" Padding="8,2" FontSize="12" Visibility="{x:Bind HasAttachment}"/>
         <local:MessageCardView Grid.Row="4" CardProjection="{x:Bind}"/>
        </Grid>
       </DataTemplate></ListView.ItemTemplate>
      </ListView>
      <ListView x:Name="GlobalSearchList" AutomationProperties.AutomationId="GlobalSearchResults" ItemsSource="{x:Bind Vm.GlobalSearchHits}" SelectionMode="None" HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind Vm.CanNavigateGlobalHits, Mode=OneWay}" Visibility="{x:Bind Vm.ShowGlobalSearchResults, Mode=OneWay}">
       <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel/></ItemsPanelTemplate></ListView.ItemsPanel>
       <ListView.ItemTemplate><DataTemplate x:DataType="models:GlobalSearchHit">
        <StackPanel Spacing="5" Margin="6,4">
         <!-- Keep expandable card controls outside the locator button. Expanding
              with the mouse or Enter/Space must never open a context request. -->
         <Button Click="GlobalHit_Click" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Padding="12,9" AutomationProperties.AutomationId="OpenGlobalHitButton">
          <StackPanel Spacing="5">
           <TextBlock Text="{x:Bind ConversationTitle}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
           <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{x:Bind Sender}" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{x:Bind KindLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="{x:Bind TimeLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
           </StackPanel>
           <TextBlock Text="{x:Bind Snippet}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
           <TextBlock Text="{x:Bind MatchedFieldsLabel}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
          </StackPanel>
         </Button>
         <local:MessageCardView CardProjection="{x:Bind}" Margin="12,0"/>
        </StackPanel>
       </DataTemplate></ListView.ItemTemplate>
      </ListView>
      <ListView x:Name="ContextMessageList" AutomationProperties.AutomationId="MessageContext" ItemsSource="{x:Bind Vm.ContextMessages}" SelectionMode="None" HorizontalContentAlignment="Stretch" Visibility="{x:Bind Vm.ShowMessageContext, Mode=OneWay}">
       <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel/></ItemsPanelTemplate></ListView.ItemsPanel>
       <ListView.ItemTemplate><DataTemplate x:DataType="models:ChatMessage">
        <Grid Padding="14,10" RowSpacing="5">
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{x:Bind Sender}" FontWeight="SemiBold"/>
          <TextBlock Text="{x:Bind KindLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <TextBlock Text="{x:Bind TimeLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <TextBlock Text="{x:Bind FocusLabel}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
         </StackPanel>
         <TextBlock Grid.Row="1" Text="{x:Bind Content}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
         <TextBlock Grid.Row="2" Text="{x:Bind Transcript}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind HasTranscript}"/>
         <local:MessageCardView Grid.Row="3" CardProjection="{x:Bind}"/>
        </Grid>
       </DataTemplate></ListView.ItemTemplate>
      </ListView>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Visibility="{x:Bind Vm.IsEmpty, Mode=OneWay}" Margin="24">
       <FontIcon Glyph="&#xE8BD;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <TextBlock Text="{x:Bind Vm.EmptyTitle, Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       <TextBlock Text="{x:Bind Vm.EmptyDescription, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
      </StackPanel>
     </Grid>
    </Border>
    <Grid Grid.Row="3" ColumnSpacing="8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="{x:Bind Vm.MessageSummary, Mode=OneWay}" AutomationProperties.AutomationId="MessageSummary" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" Visibility="{x:Bind Vm.ShowConversationMessages, Mode=OneWay}"/>
     <StackPanel Grid.Column="1" Spacing="6" Visibility="{x:Bind Vm.ShowConversationMessages, Mode=OneWay}">
      <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind Vm.ShowCursorMessageNavigation, Mode=OneWay}">
       <Button Content="上一批" AutomationProperties.AutomationId="PreviousMessageBatchButton" Click="MessageBatch_Click" Tag="previous" IsEnabled="{x:Bind Vm.CanLoadPreviousMessageBatch, Mode=OneWay}" ToolTipService.ToolTip="读取前面最多 50 条，超出窗口时释放另一端"/>
       <Button Content="下一批" AutomationProperties.AutomationId="NextMessageBatchButton" Click="MessageBatch_Click" Tag="next" IsEnabled="{x:Bind Vm.CanLoadNextMessageBatch, Mode=OneWay}" ToolTipService.ToolTip="读取后面最多 50 条，超出窗口时释放另一端"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6">
       <Button Content="加载更多" AutomationProperties.AutomationId="LoadMoreButton" Command="{x:Bind Vm.LoadMoreCommand}" IsEnabled="{x:Bind Vm.CanLoadMore, Mode=OneWay}" Visibility="{x:Bind Vm.ShowLegacyMessageNavigation, Mode=OneWay}"/>
       <Button Content="刷新首屏" AutomationProperties.AutomationId="RefreshMessagesButton" Click="MessageBatch_Click" Tag="refresh" IsEnabled="{x:Bind Vm.CanRefreshMessages, Mode=OneWay}"/>
      </StackPanel>
     </StackPanel>
     <TextBlock Text="{x:Bind Vm.GlobalSearchSummary, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" Visibility="{x:Bind Vm.ShowGlobalSearchResults, Mode=OneWay}"/>
     <Button Grid.Column="1" Content="加载下一页" AutomationProperties.AutomationId="LoadMoreGlobalButton" Command="{x:Bind Vm.LoadMoreGlobalCommand}" IsEnabled="{x:Bind Vm.CanLoadMoreGlobal, Mode=OneWay}" Visibility="{x:Bind Vm.ShowGlobalSearchResults, Mode=OneWay}"/>
     <TextBlock Text="{x:Bind Vm.ContextSummary, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" Visibility="{x:Bind Vm.ShowMessageContext, Mode=OneWay}"/>
    </Grid>
   </Grid>

   <!-- Details: export, tasks, scenes, voice -->
   <TabView x:Name="DetailTabs" Grid.Column="2" IsAddTabButtonVisible="False" TabWidthMode="SizeToContent" VerticalAlignment="Stretch" AutomationProperties.AutomationId="DetailTabs">
    <TabViewItem IsClosable="False" Header="导出" MinWidth="58" Padding="8,6" FontSize="12" AutomationProperties.AutomationId="ExportTab">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12" Padding="2,8,4,4">
       <TextBlock Text="导出的内容与消息预览完全一致：会话、日期和关键词均以已应用的筛选为准；文件内按时间正序排列。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <CheckBox Content="尝试恢复图片（需要微信图片密钥）" IsChecked="{x:Bind Vm.EnableImages, Mode=TwoWay}" IsEnabled="{x:Bind Vm.CanWork, Mode=OneWay}"/>
       <Button Content="导出 Markdown…" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ExportButton" Tag="markdown" Click="Export_Click" IsEnabled="{x:Bind Vm.CanExport, Mode=OneWay}"/>
       <Button Content="导出 JSON…" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ExportJsonButton" Tag="json" Click="Export_Click" IsEnabled="{x:Bind Vm.CanExport, Mode=OneWay}"/>
       <StackPanel Spacing="6">
        <Button Content="导出 PDF…" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ExportPdfButton" Tag="pdf" Click="Export_Click" IsEnabled="{x:Bind Vm.CanExport, Mode=OneWay}"/>
        <CheckBox Content="同时保留每一页的 PNG 图片" IsChecked="{x:Bind Vm.IncludePngPages, Mode=TwoWay}" IsEnabled="{x:Bind Vm.CanStartOperation, Mode=OneWay}" FontSize="12"/>
       </StackPanel>
       <TextBlock Text="保存位置由系统文件对话框选择；导出文件只写入你选择的位置。" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <StackPanel Spacing="8" Visibility="{x:Bind Vm.HasResult, Mode=OneWay}">
        <TextBlock Text="最近结果" FontWeight="SemiBold"/>
        <TextBlock Text="{x:Bind Vm.ResultSummary, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"/>
        <TextBlock AutomationProperties.AutomationId="ExportPath" Text="{x:Bind Vm.ResultPath, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
         <Button Content="打开" Click="OpenFile_Click"/>
         <Button Content="打开所在文件夹" Click="OpenFolder_Click"/>
        </StackPanel>
       </StackPanel>
      </StackPanel>
     </ScrollViewer>
    </TabViewItem>

    <TabViewItem IsClosable="False" Header="任务" MinWidth="58" Padding="8,6" FontSize="12" AutomationProperties.AutomationId="TasksTab">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="10" Padding="2,8,4,4">
       <TextBlock Text="把当前筛选生成可追溯的本地任务记录，再复制到普通文件夹或 Obsidian。所有写入都在本机。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <StackPanel Spacing="4">
        <TextBlock Text="导出格式" FontWeight="SemiBold" FontSize="12"/>
        <CheckBox Content="Markdown" IsChecked="{x:Bind Vm.ExportMarkdown, Mode=TwoWay}" IsEnabled="{x:Bind Vm.CanStartOperation, Mode=OneWay}"/>
        <CheckBox Content="JSON" IsChecked="{x:Bind Vm.ExportJson, Mode=TwoWay}" IsEnabled="{x:Bind Vm.CanStartOperation, Mode=OneWay}"/>
        <CheckBox Content="PDF" IsChecked="{x:Bind Vm.ExportPdf, Mode=TwoWay}" IsEnabled="{x:Bind Vm.CanStartOperation, Mode=OneWay}"/>
       </StackPanel>
       <ComboBox Header="投递目标" SelectedValuePath="Tag" SelectedValue="{x:Bind Vm.TargetKind, Mode=TwoWay}" HorizontalAlignment="Stretch" IsEnabled="{x:Bind Vm.CanStartOperation, Mode=OneWay}">
        <ComboBoxItem Content="只保存任务，不投递" Tag="none"/>
        <ComboBoxItem Content="复制到文件夹" Tag="folder"/>
        <ComboBoxItem Content="复制到 Obsidian 仓库" Tag="obsidian"/>
       </ComboBox>
       <Grid ColumnSpacing="6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox Header="目标文件夹" Text="{x:Bind Vm.TargetFolder, Mode=TwoWay}" PlaceholderText="选择或输入已有文件夹" IsEnabled="{x:Bind Vm.CanWork, Mode=OneWay}"/>
        <Button Grid.Column="1" Content="选择…" Click="ChooseTargetFolder_Click" VerticalAlignment="Bottom" IsEnabled="{x:Bind Vm.CanStartOperation, Mode=OneWay}"/>
       </Grid>
       <Grid ColumnSpacing="6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox Header="Obsidian 仓库" Text="{x:Bind Vm.ObsidianVault, Mode=TwoWay}" PlaceholderText="选择已有仓库根目录" IsEnabled="{x:Bind Vm.CanWork, Mode=OneWay}"/>
        <Button Grid.Column="1" Content="选择…" Click="ChooseVault_Click" VerticalAlignment="Bottom" IsEnabled="{x:Bind Vm.CanStartOperation, Mode=OneWay}"/>
       </Grid>
       <Button Content="生成导出任务" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Command="{x:Bind Vm.ExportJobCommand}" AutomationProperties.AutomationId="ExportJobButton"/>
       <Grid ColumnSpacing="6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="任务历史" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="刷新" Command="{x:Bind Vm.RefreshJobsCommand}" IsEnabled="{x:Bind Vm.CanManageJobs, Mode=OneWay}"/>
       </Grid>
       <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="6" Padding="4" MinHeight="140">
        <ListView x:Name="JobsList" AutomationProperties.AutomationId="JobsList" ItemsSource="{x:Bind Vm.Jobs}" IsEnabled="{x:Bind Vm.CanManageJobs, Mode=OneWay}" SelectionMode="None" HorizontalContentAlignment="Stretch" MaxHeight="280">
         <ListView.ItemTemplate><DataTemplate x:DataType="models:JobSummary">
          <StackPanel Spacing="4" Padding="6,8">
           <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" FontSize="12"/>
           <TextBlock Text="{x:Bind TimeLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
           <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="详情" FontSize="11" Padding="8,2" Click="ShowJobDetail_Click"/>
            <Button Content="打开目录" FontSize="11" Padding="8,2" Click="OpenJobFolder_Click"/>
            <Button Content="重新投递" FontSize="11" Padding="8,2" Click="DeliverJob_Click" IsEnabled="{x:Bind CanRedeliver}"/>
           </StackPanel>
          </StackPanel>
         </DataTemplate></ListView.ItemTemplate>
        </ListView>
       </Border>
       <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="6" Padding="10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <StackPanel Spacing="8">
         <TextBlock Text="手动清理历史" FontWeight="SemiBold"/>
         <TextBlock Text="先只读预览旧的已完成任务和可统计的本地工件逻辑大小；不会后台自动清理。" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
         <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ComboBox Header="保留天数" ItemsSource="{x:Bind Vm.PruneRetentionDayOptions}" SelectedItem="{x:Bind Vm.PruneRetentionDays, Mode=TwoWay}" IsEnabled="{x:Bind Vm.CanManageJobs, Mode=OneWay}"/>
          <Button Grid.Column="1" Content="预览并清理…" Click="CleanupJobs_Click" VerticalAlignment="Bottom" IsEnabled="{x:Bind Vm.CanManageJobs, Mode=OneWay}" AutomationProperties.AutomationId="CleanupJobsButton"/>
         </Grid>
         <TextBlock Text="永久删除仅涉及应用管理的本地任务副本；外部文件夹 / Obsidian 投递副本和用户 JSON 原件不受影响。未完成或可恢复任务会保护。" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
       </Border>
      </StackPanel>
     </ScrollViewer>
    </TabViewItem>

    <TabViewItem IsClosable="False" Header="场景" MinWidth="58" Padding="8,6" FontSize="12" AutomationProperties.AutomationId="ScenesTab">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="10" Padding="2,8,4,4">
       <TextBlock Text="内置场景来自上游项目。选择场景会套用日期与关键词，再点中栏“应用筛选”确认。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <ComboBox x:Name="ScenesCombo" AutomationProperties.AutomationId="ScenesCombo" ItemsSource="{x:Bind Vm.Scenes}" SelectedItem="{x:Bind Vm.SelectedScene, Mode=TwoWay}" DisplayMemberPath="Label" Header="场景" HorizontalAlignment="Stretch" IsEnabled="{x:Bind Vm.CanWork, Mode=OneWay}"/>
       <TextBlock Text="{x:Bind Vm.SelectedScene.Description, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"/>
       <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="6" Padding="10" Visibility="{x:Bind Vm.HasScenePrompt, Mode=OneWay}">
        <TextBlock Text="{x:Bind Vm.SelectedScenePrompt, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"/>
       </Border>
       <Button Content="应用此场景的筛选" HorizontalAlignment="Stretch" Command="{x:Bind Vm.ApplyFiltersCommand}"/>
       <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4"/>
       <TextBlock Text="保存当前筛选为场景" FontWeight="SemiBold"/>
       <TextBox Header="名称" Text="{x:Bind Vm.CustomSceneName, Mode=TwoWay}" PlaceholderText="例如：项目群本周" IsEnabled="{x:Bind Vm.CanWork, Mode=OneWay}"/>
       <TextBox Header="提示词（写入交付文件）" Text="{x:Bind Vm.CustomScenePrompt, Mode=TwoWay}" PlaceholderText="告诉后续 AI 如何总结这段聊天" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="64" IsEnabled="{x:Bind Vm.CanWork, Mode=OneWay}"/>
       <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="保存场景" Command="{x:Bind Vm.SaveSceneCommand}" AutomationProperties.AutomationId="SaveSceneButton"/>
        <Button Content="删除所选自定义场景" Command="{x:Bind Vm.DeleteSceneCommand}"/>
       </StackPanel>
      </StackPanel>
     </ScrollViewer>
    </TabViewItem>

    <TabViewItem IsClosable="False" Header="语音" MinWidth="58" Padding="8,6" FontSize="12" AutomationProperties.AutomationId="VoiceTab">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="10" Padding="2,8,4,4">
       <TextBlock Text="{x:Bind Vm.VoiceStatusText, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <ToggleSwitch Header="连接时加载语音" IsOn="{x:Bind Vm.EnableVoice, Mode=TwoWay}" IsEnabled="{x:Bind Vm.CanStartOperation, Mode=OneWay}" OnContent="已启用" OffContent="未启用"/>
       <TextBlock Text="语音转写在本机用 faster-whisper 完成，不上传音频。首次准备模型会下载约 460 MB 到本机应用数据目录。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <Button Content="准备语音模型…" HorizontalAlignment="Stretch" Click="PrepareVoice_Click" IsEnabled="{x:Bind Vm.CanWork, Mode=OneWay}" AutomationProperties.AutomationId="PrepareVoiceButton"/>
       <Button Content="转写当前会话的语音" HorizontalAlignment="Stretch" Command="{x:Bind Vm.TranscribeCommand}" AutomationProperties.AutomationId="TranscribeButton"/>
       <TextBlock Text="转写只作用于当前已应用筛选内的语音消息；不会改写微信数据库。" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <Button Content="刷新语音状态" HorizontalAlignment="Left" Command="{x:Bind Vm.RefreshVoiceCommand}"/>
      </StackPanel>
     </ScrollViewer>
    </TabViewItem>
   </TabView>
  </Grid>

  <!-- Status -->
  <StackPanel Grid.Row="3" Spacing="6">
   <InfoBar IsOpen="{x:Bind Vm.HasError, Mode=OneWay}" IsClosable="False" Severity="Error" Title="操作未完成" Message="{x:Bind Vm.Error, Mode=OneWay}" AutomationProperties.AutomationId="ErrorBar"/>
   <Grid ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Spacing="4">
     <ProgressBar IsIndeterminate="{x:Bind Vm.IsBusy, Mode=OneWay}" Visibility="{x:Bind Vm.IsBusy, Mode=OneWay}"/>
     <TextBlock Text="{x:Bind Vm.ProgressLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind Vm.IsBusy, Mode=OneWay}"/>
     <TextBlock Text="{x:Bind Vm.Status, Mode=OneWay}" AutomationProperties.AutomationId="TaskStatus" TextWrapping="Wrap"/>
    </StackPanel>
    <TextBlock Grid.Column="1" Text="本地处理 · 无遥测 · 不上传" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom"/>
   </Grid>
  </StackPanel>
 </Grid>
</Window>
